<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SkyEditor.SaveEditor.Gui.ConfirmDeleteDialog"
        Title="Confirm"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="16" MaxWidth="360">
        <TextBlock Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="CancelButton" Content="Cancel" Click="OnCancelClick" IsDefault="True" IsCancel="True" />
            <Button Name="ConfirmButton" Content="Say Farewell" Click="OnConfirmClick" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
